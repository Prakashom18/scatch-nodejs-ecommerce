<%- include('partials/navbar') %>


<div class="min-h-screen w-full bg-white p-10">

  <!-- Products Grid (STATIC) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

    <% product.forEach(function(pro){ %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-5">
      <div class="w-full h-48 bg-gray-100 rounded-lg flex items-center justify-center">
     <% if (pro.image) { %>
  <img
    src="data:image/jpeg;base64,<%= pro.image.toString('base64') %>"
    class="h-full object-contain"
  />
<% } else { %>
  <span class="text-gray-400">No Image</span>
<% } %>


      </div>

      <div class="mt-4 bg-orange-50" >
        <h2 class="text-xl font-semibold text-gray-800"><%=pro.name%></h2>
       

        <div class="flex justify-between items-center mt-4">
          <span class="text-lg font-bold text-green-600"><%=pro.price%></span>
          <a href="/addtocart/<%=pro._id %>" class="px-4 py-2 bg-transparent text-orange-600 outline-none rounded-lg">
             Add to Cart
          </button>
          </a>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- Product Card -->
    
  </div>
</div>
<%- include('partials/footer') %>