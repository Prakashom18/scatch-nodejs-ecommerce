<%- include('partials/header', { title: 'Home Page' }) %>

<% if (error && error.length > 0) { %>
  <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 bg-red-500 rounded-md">
    <span class="text-white"><%= error %></span>
  </div>
<% } %>

