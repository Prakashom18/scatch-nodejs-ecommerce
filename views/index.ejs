<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login / Register</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>

  <div class=" text-2xl text-blue-400">Scatch</div>
  <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">

    <!-- Main Container -->
    <div class="w-full max-w-6xl flex flex-col md:flex-row justify-between gap-12">

      <!-- ================= Create Account ================= -->
      <div class="flex-1 flex flex-col items-center">
        <h1 class="text-3xl font-semibold text-gray-800 mb-6">
          Welcome to <span class="text-blue-400">  Scatch</span>
        </h1>

        <form class="w-full max-w-md bg-red-200 p-10 rounded-lg shadow-md flex flex-col gap-5" action="/users/register" method="post">
          <h2 class="text-xl font-medium text-center text-gray-700">
            Create your account
          </h2>

          <input
            type="text"
            name="name"
            placeholder="Full Name"
            class="px-4 py-3 outline-none rounded-md text-lg"
          />

          <input
            type="email"
            name="email"
            placeholder="Email"
            class="px-4 py-3 outline-none rounded-md text-lg"
          />

          <input
            type="password"
            name="password"
            placeholder="Password"
            class="px-4 py-3 outline-none rounded-md text-lg"
          />

          <input
            type="submit"
            value="Create Account"
            class="rounded-md px-4 py-3 bg-green-500 text-white text-lg cursor-pointer hover:bg-green-600 transition"
          />
        </form>
      </div>

      <!-- ================= Login ================= -->
      <div class="flex-1 flex flex-col items-center">
        <h1 class="text-3xl font-semibold text-gray-800 mb-6">
          <span class="text-pink-400">Welcome</span> Back
        </h1>

        <form class="w-full max-w-md bg-blue-200 p-10 rounded-lg shadow-md flex flex-col gap-5" method="post" action="/users/login">
          <h2 class="text-xl font-medium text-center text-gray-700">
            Login to your account
          </h2>

          <input
            type="email"
            name="email"
            placeholder="Email"
            class="px-4 py-3 outline-none rounded-md text-lg"
          />

          <input
            type="password"
            name="password"
            placeholder="Password"
            class="px-4 py-3 outline-none rounded-md text-lg"
          />

          <input
            type="submit"
            value="Login"
            class="rounded-md px-4 py-3 bg-blue-500 text-white text-lg cursor-pointer hover:bg-blue-600 transition"
          />
        </form>
      </div>

    </div>
  </div>

</body>
</html>
