<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-white text-black">

<!-- Header -->
<header class="w-full border-b">
    <div class="max-w-6xl mx-auto px-8 py-4 flex items-center justify-between">
        <h1 class="text-xl font-semibold">Your Cart</h1>
        <a href="/logout" class="text-red-600 font-medium hover:underline">
            Logout
        </a>
    </div>
</header>

<!-- Cart Items -->
<main class="max-w-6xl mx-auto px-8 py-8 space-y-8">

    <% if (product && product.length > 0) { %>

        <% product.forEach(function(pro) { %>

        <!-- Product Row -->
        <div class="flex items-center gap-10 py-6 border-b">

            <!-- Left: Image -->
            <div class="w-52 h-52 bg-gray-100 flex items-center justify-center flex-shrink-0">
                <% if (pro.image) { %>
                    <img
                        src="data:image/jpeg;base64,<%= pro.image.toString('base64') %>"
                        class="h-full w-full object-contain"
                    />
                <% } else { %>
                    <span class="text-gray-400">No Image</span>
                <% } %>
            </div>

            <!-- Right: Details -->
            <div class="flex-1 space-y-3">

                <h2 class="text-2xl font-semibold text-red-200">
                    <%= pro.name %>
                </h2>

                <!-- Original Price -->
                <p class="text-lg">
                    Price:
                    <span class="<%= pro.discount > 0 ? 'line-through text-gray-400' : 'font-medium' %>">
                        Rs <%= pro.price %>
                    </span>
                </p>

                <!-- Discount Section -->
                <% if (pro.discount > 0) { %>
                    <p class="text-green-600 font-medium">
                        Discount: <%= pro.discount %>%
                    </p>

                    <p class="text-xl font-semibold">
                        Final Price:
                        Rs <%= pro.price - (pro.price * pro.discount / 100) %>
                    </p>
                <% } %>

                <!-- Actions -->
                <div class="flex items-center gap-4 mt-4">
                    <button class="px-4 py-1 bg-gray-200">−</button>
                    <span class="text-lg">1</span>
                    <button class="px-4 py-1 bg-gray-200">+</button>

                    <button class="ml-auto px-6 py-2 bg-red-500 text-white">
                        Remove
                    </button>
                </div>

            </div>

        </div>

        <% }) %>

    <% } else { %>

        <!-- Empty Cart -->
        <p class="text-center text-gray-500 text-lg">
            Your cart is empty.
        </p>

    <% } %>

</main>

</body>
</html>
