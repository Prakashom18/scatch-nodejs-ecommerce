<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 text-slate-700 min-h-screen">

<div class="flex min-h-screen">

  <!-- Sidebar -->
  <aside class="w-64 bg-slate-200/60 backdrop-blur border-r p-6">
    <h2 class="text-xl font-semibold mb-6 text-slate-800">Admin Panel</h2>
    <ul class="space-y-4 text-sm">
      <li><a href="#create" class="hover:text-blue-600">Create Product</a></li>
      <li><a href="#products" class="hover:text-blue-600">All Products</a></li>
    </ul>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 flex items-center justify-center p-6">

    <div class="w-full max-w-6xl bg-slate-50 rounded-2xl p-8 shadow-sm">
      <h1 class="text-lg font-semibold mb-5 text-slate-800">
        Create New Product
      </h1>

      <form action="/product/create" method="POST"
        class="grid grid-cols-1 md:grid-cols-2 gap-6" enctype="multipart/form-data">

        <!-- Product Details -->
        <div class="bg-white p-5 rounded-xl border border-slate-200">
          <h2 class="text-sm font-semibold mb-4 text-slate-700">
            Product Details
          </h2>

          <div class="space-y-3">
            <input type="file" name="image" />

            <input type="text" name="name" placeholder="Product Name"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />

            <input type="number" name="price" placeholder="Price"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />

            <input type="number" name="discountPrice" placeholder="Discount Price"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />
          </div>
        </div>

        <!-- Panel Details (TEXT INPUTS) -->
        <div class="bg-white p-5 rounded-xl border border-slate-200">
          <h2 class="text-sm font-semibold mb-4 text-slate-700">
            Panel Details
          </h2>

          <div class="space-y-3">
            <input type="text" name="bgColor"
              placeholder="Background Color (e.g. #f1f5f9)"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />

            <input type="text" name="panelColor"
              placeholder="Panel Color (e.g. #ffffff)"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />

            <input type="text" name="textColor"
              placeholder="Text Color (e.g. #334155)"
              class="w-full p-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-400" />
          </div>
        </div>

        <!-- Submit -->
        <div class="md:col-span-2 flex justify-end">
          <button
            class="bg-blue-500 text-white px-6 py-2.5 text-sm rounded-lg hover:bg-blue-600 transition">
            Create Product
          </button>
        </div>

      </form>
    </div>

  </main>
</div>

</body>
</html>
